# Delta Exchange API Credentials
# Generated from Delta Exchange -> Settings -> API Keys (Permissions: Read, Trade/Orders)
DELTA_API_KEY=your_delta_api_key_here
DELTA_API_SECRET=your_delta_api_secret_here

# Delta Exchange Base URL:
# Delta India:  https://api.india.delta.exchange
# Delta Global: https://api.delta.exchange
# Delta Testnet: https://api.testnet.delta.exchange
DELTA_BASE_URL=https://api.india.delta.exchange

# Maximum allowed unrealised loss in USD before emergency close (default: 15)
SMART_SL_LIMIT=15

# Polling frequency in milliseconds (1000 ms = 1 second)
SMART_SL_INTERVAL_MS=1000

# Simulation mode: true = simulate only (safe for testing), false = real order execution
SMART_SL_DRY_RUN=true

# Telegram Bot Integration (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram User/Chat ID (Leave empty initially if unsure; messaging the bot will print your ID)
TELEGRAM_CHAT_ID=
